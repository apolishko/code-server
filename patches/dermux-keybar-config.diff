+	private bindButtonGesture(button: HTMLButtonElement, buttonConfig: IKeybarButtonConfig): void {
+		let startY = 0;
+		let latestDeltaY = 0;
+		let trackingPointer = false;
+		let focusRestoreTarget: HTMLElement | undefined;
+
+		const resetPreview = () => {
+			button.classList.remove('cs-dermux-keybar-btn-swipe-up', 'cs-dermux-keybar-btn-swipe-down');
+		};
+
+		button.addEventListener('pointerdown', event => {
+			event.preventDefault();
+			trackingPointer = true;
+			startY = event.clientY;
+			latestDeltaY = 0;
+			focusRestoreTarget = this.captureRestorableFocusTarget();
+			button.setPointerCapture(event.pointerId);
+			resetPreview();
+		});
+
+		button.addEventListener('pointermove', event => {
+			if (!trackingPointer) {
+				return;
+			}
+
+			latestDeltaY = event.clientY - startY;
+			resetPreview();
+			if (latestDeltaY <= -CodeServerClient.KEYBAR_SWIPE_THRESHOLD_PX && buttonConfig.up) {
+				button.classList.add('cs-dermux-keybar-btn-swipe-up');
+			} else if (latestDeltaY >= CodeServerClient.KEYBAR_SWIPE_THRESHOLD_PX && buttonConfig.down) {
+				button.classList.add('cs-dermux-keybar-btn-swipe-down');
+			}
+		});
+
+		const finalizeGesture = async (pointerId: number) => {
+			if (!trackingPointer) {
+				return;
+			}
+
+			trackingPointer = false;
+			resetPreview();
+			button.releasePointerCapture(pointerId);
+
+			const action = this.resolveButtonAction(buttonConfig, latestDeltaY);
+			if (this.tryToggleModifierFromAction(buttonConfig, action)) {
+				this.restoreFocusAfterKeybarInteraction(focusRestoreTarget);
+				return;
+			}
+			await this.dispatchKeybarAction(action);
+			this.restoreFocusAfterKeybarInteraction(focusRestoreTarget);
+		};
+
+		button.addEventListener('pointerup', event => {
+			void finalizeGesture(event.pointerId);
+		});
+		button.addEventListener('pointercancel', event => {
+			void finalizeGesture(event.pointerId);
+		});
+	}
