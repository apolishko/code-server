+		if (typeof navigator === 'undefined' || !('serviceWorker' in navigator)) {
+			return;
+		}
+
+		try {
+			const targetScopePath = new URL(scope, window.location.origin).pathname;
+			const registrations = await navigator.serviceWorker.getRegistrations();
+			let matchedRegistrations = 0;
+			let unregisteredRegistrations = 0;
+
+			for (const registration of registrations) {
+				const registrationScopePath = new URL(registration.scope, window.location.origin).pathname;
+				const scopeMatches = registrationScopePath.startsWith(targetScopePath) || targetScopePath.startsWith(registrationScopePath);
+				if (!scopeMatches) {
+					continue;
+				}
+
+				matchedRegistrations++;
+				const didUnregister = await registration.unregister();
+				if (didUnregister) {
+					unregisteredRegistrations++;
+				}
+			}
+
+			this.logService.info(`[Service Worker] bypass (${reason}), unregistered ${unregisteredRegistrations}/${matchedRegistrations} registrations for scope ${targetScopePath}`);
