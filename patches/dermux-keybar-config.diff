+		const outputKey = shouldApplyLetterCase ? this.normalizeLetterKey(resolvedVariant.key) : resolvedVariant.key;
+		return {
+			id: config.id,
+			label: resolvedVariant.label,
+			widthUnits: config.widthUnits,
