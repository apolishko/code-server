+	private getWorkspaceKeybarConfigUri() {
+		const workspace = this.workspaceContextService.getWorkspace();
+		const firstFolder = workspace.folders[0];
+		if (!firstFolder) {
+			return undefined;
+		}
+
+		return joinPath(firstFolder.uri, CodeServerClient.KEYBAR_WORKSPACE_CONFIG_RELATIVE_PATH);
+	}
+
+	private parseAndValidateKeybarConfig(rawHjson: string): IKeybarConfigModel | undefined {
+		try {
+			const parsed = Hjson.parse(rawHjson);
+			return this.toKeybarConfigModel(parsed);
+		} catch (error) {
+			this.logService.warn(`[Dermux Keybar] failed to parse config: ${String(error)}`);
+			return undefined;
+		}
+	}
+
+	private toKeybarConfigModel(parsed: unknown): IKeybarConfigModel | undefined {
+		if (typeof parsed !== 'object' || parsed === null) {
+			return undefined;
+		}
+
+		const configLike = parsed as { version?: unknown; rows?: unknown };
+		if (configLike.version !== 1 || !Array.isArray(configLike.rows) || configLike.rows.length !== 2) {
+			return undefined;
+		}
+
+		const firstRow = this.toKeybarRow(configLike.rows[0]);
+		const secondRow = this.toKeybarRow(configLike.rows[1]);
+		if (!firstRow || !secondRow) {
+			return undefined;
+		}
+
+		return {
+			version: 1,
+			rows: [firstRow, secondRow],
+		};
+	}
+
+	private toKeybarRow(row: unknown): IKeybarButtonConfig[] | undefined {
+		if (!Array.isArray(row) || row.length < 1) {
+			return undefined;
+		}
+
+		const buttons: IKeybarButtonConfig[] = [];
+		for (const button of row) {
+			const normalized = this.toKeybarButton(button);
+			if (!normalized) {
+				return undefined;
+			}
+			buttons.push(normalized);
+		}
+
+		return buttons;
+	}
+
+	private toKeybarButton(rawButton: unknown): IKeybarButtonConfig | undefined {
+		if (typeof rawButton !== 'object' || rawButton === null) {
+			return undefined;
+		}
+
+		const buttonLike = rawButton as { id?: unknown; label?: unknown; tap?: unknown; up?: unknown; down?: unknown };
+		if (typeof buttonLike.id !== 'string' || typeof buttonLike.label !== 'string') {
+			return undefined;
+		}
+
+		const tap = this.toKeybarAction(buttonLike.tap);
+		if (!tap) {
+			return undefined;
+		}
+
+		const up = buttonLike.up === undefined ? undefined : this.toKeybarAction(buttonLike.up);
+		const down = buttonLike.down === undefined ? undefined : this.toKeybarAction(buttonLike.down);
+		if (buttonLike.up !== undefined && !up) {
+			return undefined;
+		}
+		if (buttonLike.down !== undefined && !down) {
+			return undefined;
+		}
+
+		return { id: buttonLike.id, label: buttonLike.label, tap, up, down };
+	}
+
+	private toKeybarAction(rawAction: unknown): IKeybarActionConfig | undefined {
+		if (typeof rawAction !== 'object' || rawAction === null) {
+			return undefined;
+		}
+
+		const actionLike = rawAction as { type?: unknown; command?: unknown; key?: unknown; text?: unknown; ctrl?: unknown; alt?: unknown; shift?: unknown; meta?: unknown };
+		if (actionLike.type !== 'command' && actionLike.type !== 'key' && actionLike.type !== 'text' && actionLike.type !== 'noop') {
+			return undefined;
+		}
+
+		if (actionLike.type === 'command' && typeof actionLike.command !== 'string') {
+			return undefined;
+		}
+		if (actionLike.type === 'key' && typeof actionLike.key !== 'string') {
+			return undefined;
+		}
+		if (actionLike.type === 'text' && typeof actionLike.text !== 'string') {
+			return undefined;
+		}
+		if (actionLike.ctrl !== undefined && typeof actionLike.ctrl !== 'boolean') {
+			return undefined;
+		}
+		if (actionLike.alt !== undefined && typeof actionLike.alt !== 'boolean') {
+			return undefined;
+		}
+		if (actionLike.shift !== undefined && typeof actionLike.shift !== 'boolean') {
+			return undefined;
+		}
+		if (actionLike.meta !== undefined && typeof actionLike.meta !== 'boolean') {
+			return undefined;
+		}
+
+		return {
+			type: actionLike.type,
+			command: typeof actionLike.command === 'string' ? actionLike.command : undefined,
+			key: typeof actionLike.key === 'string' ? actionLike.key : undefined,
+			text: typeof actionLike.text === 'string' ? actionLike.text : undefined,
+			ctrl: typeof actionLike.ctrl === 'boolean' ? actionLike.ctrl : undefined,
+			alt: typeof actionLike.alt === 'boolean' ? actionLike.alt : undefined,
+			shift: typeof actionLike.shift === 'boolean' ? actionLike.shift : undefined,
+			meta: typeof actionLike.meta === 'boolean' ? actionLike.meta : undefined,
+		};
+	}
+
+	private async dispatchKeybarAction(action: IKeybarActionConfig): Promise<boolean> {
+		if (action.type === 'noop') {
+			return true;
+		}
+
+		if (action.type === 'command') {
+			if (!action.command) {
+				return false;
+			}
+			try {
+				await this.commandService.executeCommand(action.command);
+				return true;
+			} catch (error) {
+				this.logService.warn(`[Dermux Keybar] command failed "${action.command}": ${String(error)}`);
+				return false;
+			}
+		}
+
+		if (action.type === 'text') {
+			if (!action.text) {
+				return false;
+			}
+			return this.insertText(action.text);
+		}
+
+		if (action.type === 'key') {
+			if (!action.key) {
+				return false;
+			}
+			return this.dispatchSyntheticKey(action);
+		}
+
+		return false;
+	}
+
+	private insertText(text: string): boolean {
+		const activeElement = document.activeElement;
+
+		if (activeElement instanceof HTMLInputElement || activeElement instanceof HTMLTextAreaElement) {
+			const start = activeElement.selectionStart ?? activeElement.value.length;
+			const end = activeElement.selectionEnd ?? activeElement.value.length;
+			activeElement.setRangeText(text, start, end, 'end');
+			activeElement.dispatchEvent(new Event('input', { bubbles: true }));
+			return true;
+		}
+
+		if (activeElement instanceof HTMLElement && activeElement.isContentEditable) {
+			return document.execCommand('insertText', false, text);
+		}
+
+		return false;
+	}
+
+	private dispatchSyntheticKey(action: IKeybarActionConfig): boolean {
+		const activeElement = document.activeElement;
+		const target = activeElement instanceof HTMLElement ? activeElement : document.body;
+		const key = action.key!;
+
+		const eventInit: KeyboardEventInit = {
+			key,
+			code: this.toKeyboardCode(key),
+			ctrlKey: action.ctrl === true,
+			altKey: action.alt === true,
+			shiftKey: action.shift === true,
+			metaKey: action.meta === true,
+			bubbles: true,
+			cancelable: true,
+		};
+
+		const didDispatch = target.dispatchEvent(new KeyboardEvent('keydown', eventInit));
+		target.dispatchEvent(new KeyboardEvent('keyup', eventInit));
+		return didDispatch;
+	}
+
+	private toKeyboardCode(key: string): string {
+		if (key.length === 1 && /^[a-zA-Z]$/.test(key)) {
+			return `Key${key.toUpperCase()}`;
+		}
+		if (key.length === 1 && /^[0-9]$/.test(key)) {
+			return `Digit${key}`;
+		}
+		return key;
+	}
