@@ -0,0 +1,67 @@
+:root {
+	--cs-dermux-keybar-height: 0px;
+	--cs-dermux-safe-area-bottom: env(safe-area-inset-bottom, 0px);
+}
+
+body.cs-dermux-keybar-enabled .monaco-workbench {
+	padding-bottom: calc(var(--cs-dermux-keybar-height) + var(--cs-dermux-safe-area-bottom));
+	box-sizing: border-box;
+}
+
+.cs-dermux-keybar {
+	position: fixed;
+	left: 0;
+	right: 0;
+	bottom: 0;
+	display: flex;
+	flex-direction: column;
+	gap: 6px;
+	padding: 8px 8px calc(8px + var(--cs-dermux-safe-area-bottom));
+	background: color-mix(in srgb, var(--vscode-editor-background) 92%, black);
+	border-top: 1px solid var(--vscode-widget-border);
+	z-index: 1700;
+}
+
+.cs-dermux-keybar.cs-dermux-keybar-hidden {
+	display: none;
+}
+
+.cs-dermux-keybar-row {
+	display: grid;
+	grid-template-columns: repeat(6, minmax(0, 1fr));
+	gap: 6px;
+}
+
+.cs-dermux-keybar-btn {
+	height: 40px;
+	min-width: 40px;
+	border: 1px solid var(--vscode-widget-border);
+	border-radius: 6px;
+	background: var(--vscode-button-secondaryBackground);
+	color: var(--vscode-button-secondaryForeground);
+	font-size: 11px;
+	font-weight: 600;
+}
+
+.cs-dermux-keybar-btn:active {
+	transform: translateY(1px);
+}
+
+.cs-dermux-keybar-handle {
+	position: fixed;
+	right: 10px;
+	bottom: calc(10px + var(--cs-dermux-safe-area-bottom));
+	height: 32px;
+	padding: 0 10px;
+	border: 1px solid var(--vscode-widget-border);
+	border-radius: 16px;
+	background: var(--vscode-button-background);
+	color: var(--vscode-button-foreground);
+	font-size: 11px;
+	font-weight: 600;
+	z-index: 1701;
+}
+
+.cs-dermux-keybar-handle.cs-dermux-keybar-handle-hidden {
+	display: none;
+}
