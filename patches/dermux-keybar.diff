+	private addKeybarToggleCommand(): void {
+		const toggleTitle = localize('dermux.toggleBottomKeybar', "Dermux: Toggle Bottom Keybar");
+
+		this._register(CommandsRegistry.registerCommand(CodeServerClient.KEYBAR_TOGGLE_COMMAND_ID, () => {
+			this.keybarVisible = !this.keybarVisible;
+			this.setKeybarVisibility();
+		}));
+
+		MenuRegistry.appendMenuItem(MenuId.CommandPalette, {
+			command: {
+				id: CodeServerClient.KEYBAR_TOGGLE_COMMAND_ID,
+				title: toggleTitle,
+			},
+		});
+	}
+
+	private createBottomKeybarSkeleton(): void {
+		if (!isMobile) {
+			return;
+		}
+
+		const body = document.body;
+		if (!body) {
+			return;
+		}
+
+		const storedVisibility = this.storageService.getBoolean(CodeServerClient.KEYBAR_VISIBLE_STORAGE_KEY, StorageScope.APPLICATION);
+		this.keybarVisible = storedVisibility ?? true;
+
+		const keybar = document.createElement('div');
+		keybar.className = 'cs-dermux-keybar';
+
+		const rowOne = this.createKeybarRow(['Esc', 'Tab', 'Ctrl', 'Alt', 'Shift', 'Find']);
+		const rowTwo = this.createKeybarRow(['Palette', 'Open', 'Save', 'GoLine', 'Close', 'Toggle']);
+		keybar.append(rowOne, rowTwo);
+
+		const handle = document.createElement('button');
+		handle.type = 'button';
+		handle.className = 'cs-dermux-keybar-handle';
+		handle.textContent = 'Keyboard';
+		handle.addEventListener('click', () => {
+			this.keybarVisible = true;
+			this.setKeybarVisibility();
+		});
+
+		body.classList.add('cs-dermux-keybar-enabled');
+		body.append(keybar, handle);
+
+		this.keybarContainer = keybar;
+		this.keybarHandle = handle;
+
+		let resizeObserver: ResizeObserver | undefined;
+		if (typeof ResizeObserver !== 'undefined') {
+			resizeObserver = new ResizeObserver(() => this.setKeybarVisibility());
+			resizeObserver.observe(keybar);
+		}
+		this._register(toDisposable(() => resizeObserver?.disconnect()));
+		this._register(toDisposable(() => {
+			this.clearKeybarInset();
+			handle.remove();
+			keybar.remove();
+		}));
+
+		this.setKeybarVisibility();
+	}
+
+	private createKeybarRow(labels: string[]): HTMLDivElement {
+		const row = document.createElement('div');
+		row.className = 'cs-dermux-keybar-row';
+
+		for (const label of labels) {
+			const button = document.createElement('button');
+			button.type = 'button';
+			button.className = 'cs-dermux-keybar-btn';
+			button.textContent = label;
+			button.addEventListener('click', () => {
+				this.logService.debug(`[Dermux Keybar] tapped "${label}"`);
+			});
+			row.appendChild(button);
+		}
+
+		return row;
+	}
+
+	private setKeybarVisibility(): void {
+		const keybar = this.keybarContainer;
+		const handle = this.keybarHandle;
+		if (!keybar || !handle) {
+			return;
+		}
+
+		keybar.classList.toggle('cs-dermux-keybar-hidden', !this.keybarVisible);
+		handle.classList.toggle('cs-dermux-keybar-handle-hidden', this.keybarVisible);
+
+		if (this.keybarVisible) {
+			const keybarHeight = `${Math.ceil(keybar.getBoundingClientRect().height)}px`;
+			document.documentElement.style.setProperty('--cs-dermux-keybar-height', keybarHeight);
+		} else {
+			this.clearKeybarInset();
+		}
+
+		this.storageService.store(
+			CodeServerClient.KEYBAR_VISIBLE_STORAGE_KEY,
+			this.keybarVisible,
+			StorageScope.APPLICATION,
+			StorageTarget.USER,
+		);
+	}
+
+	private clearKeybarInset(): void {
+		document.documentElement.style.setProperty('--cs-dermux-keybar-height', '0px');
+	}
 }
